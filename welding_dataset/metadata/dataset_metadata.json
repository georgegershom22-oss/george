{
  "dataset_name": "Welding Inverse Design Dataset",
  "dataset_version": "1.0.0",
  "rows": 10000,
  "licenses": "CC BY 4.0",
  "sources": [
    "Physics-informed synthesis; no proprietary data",
    "Engineering references: materials properties (approximate)",
    "Common process windows for USW, Laser, RSW"
  ],
  "columns": [
    {"name": "row_id", "role": "meta", "dtype": "integer", "unit": null, "description": "Row identifier"},
    {"name": "seed", "role": "meta", "dtype": "integer", "unit": null, "description": "Random seed used for this row"},

    {"name": "anode_material", "role": "input", "dtype": "category", "unit": null, "description": "Material of anode side"},
    {"name": "cathode_material", "role": "input", "dtype": "category", "unit": null, "description": "Material of cathode side"},
    {"name": "tab_thickness_um", "role": "input", "dtype": "float", "unit": "µm", "description": "Tab thickness"},
    {"name": "surface_finish", "role": "input", "dtype": "category", "unit": null, "description": "Surface finish or coating"},
    {"name": "welding_technique", "role": "input", "dtype": "category", "unit": null, "description": "USW, Laser, or RSW"},
    {"name": "power_W", "role": "input", "dtype": "float", "unit": "W", "description": "Power (USW peak or Laser CW power)"},
    {"name": "pulse_energy_J", "role": "input", "dtype": "float", "unit": "J", "description": "Laser pulse energy if pulsed; else NaN"},
    {"name": "amplitude_um", "role": "input", "dtype": "float", "unit": "µm", "description": "USW vibration amplitude; else 0/NaN"},
    {"name": "force_N", "role": "input", "dtype": "float", "unit": "N", "description": "Clamping/electrode force"},
    {"name": "weld_time_ms", "role": "input", "dtype": "float", "unit": "ms", "description": "Weld duration"},
    {"name": "laser_speed_mm_s", "role": "input", "dtype": "float", "unit": "mm/s", "description": "Laser travel speed for CW; else 0/NaN"},
    {"name": "pulse_frequency_Hz", "role": "input", "dtype": "float", "unit": "Hz", "description": "Laser pulse frequency if pulsed; else 0/NaN"},
    {"name": "preheat_temp_C", "role": "input", "dtype": "float", "unit": "°C", "description": "Pre-heat temperature of samples"},
    {"name": "clamp_area_mm2", "role": "input", "dtype": "float", "unit": "mm^2", "description": "Apparent clamp/contact area"},
    {"name": "weld_length_mm", "role": "input", "dtype": "float", "unit": "mm", "description": "Effective weld length or overlap length"},
    {"name": "current_kA", "role": "input", "dtype": "float", "unit": "kA", "description": "RSW welding current; else 0/NaN"},
    {"name": "electrode_diameter_mm", "role": "input", "dtype": "float", "unit": "mm", "description": "RSW electrode face diameter; else 0/NaN"},
    {"name": "spot_diameter_mm", "role": "input", "dtype": "float", "unit": "mm", "description": "Laser spot diameter; else 0/NaN"},
    {"name": "passes", "role": "input", "dtype": "integer", "unit": null, "description": "Number of laser passes; else 0/1"},
    {"name": "usw_frequency_kHz", "role": "input", "dtype": "float", "unit": "kHz", "description": "USW frequency; else 0/NaN"},
    {"name": "continuous_wave", "role": "input", "dtype": "boolean", "unit": null, "description": "Laser mode CW vs pulsed"},

    {"name": "cte_mismatch_ppm_C", "role": "input", "dtype": "float", "unit": "ppm/°C", "description": "CTE mismatch between materials (derived)"},
    {"name": "k_eff_W_mK", "role": "input", "dtype": "float", "unit": "W/mK", "description": "Effective thermal conductivity (derived)"},

    {"name": "energy_input_J", "role": "forward_output", "dtype": "float", "unit": "J", "description": "Total energy input"},
    {"name": "linear_energy_J_per_mm", "role": "forward_output", "dtype": "float", "unit": "J/mm", "description": "Energy per unit length"},
    {"name": "energy_density_J_per_mm2", "role": "forward_output", "dtype": "float", "unit": "J/mm^2", "description": "Energy per unit area"},
    {"name": "interface_peak_temp_C", "role": "forward_output", "dtype": "float", "unit": "°C", "description": "Peak interface temperature"},
    {"name": "HAZ_width_um", "role": "forward_output", "dtype": "float", "unit": "µm", "description": "Heat-affected zone width"},
    {"name": "bond_area_mm2", "role": "forward_output", "dtype": "float", "unit": "mm^2", "description": "Bonded/nugget area"},
    {"name": "nugget_diameter_mm", "role": "forward_output", "dtype": "float", "unit": "mm", "description": "Equivalent nugget diameter where applicable"},
    {"name": "porosity_percent", "role": "forward_output", "dtype": "float", "unit": "%", "description": "Porosity percentage"},
    {"name": "void_fraction", "role": "forward_output", "dtype": "float", "unit": null, "description": "Void fraction (0-1)"},
    {"name": "contact_resistance_mOhm_initial", "role": "forward_output", "dtype": "float", "unit": "mΩ", "description": "Initial contact resistance"},
    {"name": "microhardness_HV0_1", "role": "forward_output", "dtype": "float", "unit": "HV", "description": "Microhardness at interface"},
    {"name": "shear_strength_N", "role": "forward_output", "dtype": "float", "unit": "N", "description": "Lap-shear strength immediately after welding"},
    {"name": "peel_strength_N", "role": "forward_output", "dtype": "float", "unit": "N", "description": "Peel strength"},
    {"name": "defect_code", "role": "forward_output", "dtype": "integer", "unit": null, "description": "0=None,1=Underweld,2=Overweld,3=Misalign"},
    {"name": "defect_label", "role": "forward_output", "dtype": "category", "unit": null, "description": "Defect label"},
    {"name": "inspection_pass", "role": "forward_output", "dtype": "boolean", "unit": null, "description": "Immediate inspection pass/fail"},
    {"name": "quality_score_0_1", "role": "forward_output", "dtype": "float", "unit": null, "description": "Composite quality score"},

    {"name": "delta_resistance_percent_100cycles", "role": "inverse_target", "dtype": "float", "unit": "%", "description": "Resistance increase after 100 thermal cycles"},
    {"name": "retained_shear_strength_percent_100cycles", "role": "inverse_target", "dtype": "float", "unit": "%", "description": "Retained shear strength after 100 cycles"},
    {"name": "crack_length_mm_100cycles", "role": "inverse_target", "dtype": "float", "unit": "mm", "description": "Average crack length after 100 cycles"},
    {"name": "delamination_prob_100cycles", "role": "inverse_target", "dtype": "float", "unit": null, "description": "Probability of delamination after 100 cycles"},
    {"name": "pass_thermal_cycles_1000", "role": "inverse_target", "dtype": "boolean", "unit": null, "description": "Pass/fail after 1000 cycles"},
    {"name": "cycles_to_failure_thermal", "role": "inverse_target", "dtype": "float", "unit": "cycles", "description": "Estimated cycles to failure"},
    {"name": "reliability_score_0_1", "role": "inverse_target", "dtype": "float", "unit": null, "description": "Composite post-cycling reliability score"}
  ],
  "notes": "Technique-specific fields may be NaN when not applicable. Derived inputs computed from materials and geometry."
}
