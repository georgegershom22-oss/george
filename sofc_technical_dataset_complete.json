{
  "dataset_metadata": {
    "title": "Comprehensive SOFC Technical Dataset for Nigeria Analysis",
    "description": "Technical and technological data for modeling SOFC performance and physical requirements in Nigeria's electricity crisis context",
    "version": "1.0",
    "created_date": "2025-10-21",
    "focus_area": "Harnessing Domestic Gas for Power: A Techno-Economic and Socio-Political Analysis of Solid Oxide Fuel Cells (SOFCs) in Mitigating Nigeria's Electricity Crisis",
    "data_sources": [
      "Academic literature",
      "Manufacturer technical reports (Bloom Energy, Siemens Energy, Rolls-Royce)",
      "International Energy Agency (IEA) reports",
      "Nigerian energy sector data",
      "Environmental and climate data for Nigeria"
    ],
    "data_categories": [
      "SOFC Performance Characteristics",
      "Fuel Flexibility Specifications",
      "Power Density and Sizing Data",
      "Operational Characteristics",
      "Nigeria-Specific Requirements",
      "Manufacturer Specifications",
      "Economic Analysis Data",
      "Environmental Impact Data"
    ]
  },
  
  "performance_characteristics": {
    "description": "Electrical and thermal efficiency data, degradation rates, and operational parameters",
    "parameters": {
      "electrical_efficiency_lhv": {
        "unit": "percentage",
        "range": "35-65%",
        "typical_values": {
          "residential": "48-55%",
          "commercial": "50-58%",
          "industrial": "55-62%",
          "utility": "58-65%"
        }
      },
      "thermal_efficiency": {
        "unit": "percentage", 
        "range": "30-40%",
        "description": "Combined heat and power potential"
      },
      "degradation_rate": {
        "unit": "% per 1000 hours",
        "range": "0.35-1.5%",
        "factors": ["operating_temperature", "fuel_quality", "cycling_frequency", "ambient_conditions"]
      },
      "stack_lifespan": {
        "unit": "hours",
        "range": "45000-78000",
        "warranty_typical": "40000-60000 hours"
      }
    }
  },
  
